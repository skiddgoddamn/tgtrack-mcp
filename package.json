{
  "name": "tgtrack-mcp",
  "version": "0.1.0",
  "description": "MCP-сервер для управления tgtrack / «Откуда Подписки» (settings.tgtrack.ru): каналы, интеграции (рекламные системы), скрипт-настройки, цели, ссылки. Read + safe writes через внутренний API (JWT + подпись H=md5(md5(JSON+T)+T)).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tgtrack-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "tgtrack",
    "telegram",
    "analytics",
    "otkuda-podpiski"
  ],
  "license": "MIT",
  "author": "skiddgoddamn (https://github.com/skiddgoddamn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skiddgoddamn/tgtrack-mcp.git"
  },
  "homepage": "https://github.com/skiddgoddamn/tgtrack-mcp#readme",
  "bugs": {
    "url": "https://github.com/skiddgoddamn/tgtrack-mcp/issues"
  }
}
